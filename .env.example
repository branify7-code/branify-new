# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# AI Blog Generation (SERVER-SIDE ONLY — set these in the Vercel dashboard,
# NEVER in the browser bundle; the AI_API_KEY must never have a VITE_ prefix)
#
#   AI_PROVIDER      "glm" (default, Z.ai OpenAI-compatible) | "openai" |
#                    "gemini" (Google OpenAI-compatible endpoint; falls back to
#                    the existing GEMINI_API_KEY when AI_API_KEY is not set) |
#                    "gateway" (Vercel AI Gateway, model ids like "zai/glm-4.6";
#                    on Vercel it authenticates with the deployment's OIDC
#                    token, so no static AI_API_KEY is required) |
#                    "custom"
#   AI_API_BASE_URL  optional override of the provider base URL
#                    (glm default: https://api.z.ai/api/paas/v4)
#   AI_API_KEY       REQUIRED unless the provider fallback covers it (see
#                    AI_PROVIDER above)
#   AI_MODEL         optional model id (glm default: glm-4.6,
#                    gateway default: zai/glm-4.6)
#   AI_TIMEOUT_MS    optional provider timeout, 15000-110000 (default 52000)
# ---------------------------------------------------------------------------
AI_PROVIDER="glm"
AI_API_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_TIMEOUT_MS=""

