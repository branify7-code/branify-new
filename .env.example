# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# AI Blog Generation (SERVER-SIDE ONLY — set these in the Vercel dashboard,
# NEVER in the browser bundle; the AI_API_KEY must never have a VITE_ prefix)
#
#   AI_PROVIDER      "glm" (default, Z.ai OpenAI-compatible) | "openai" |
#                    "gemini" (Google OpenAI-compatible endpoint; falls back to
#                    the existing GEMINI_API_KEY when AI_API_KEY is not set) |
#                    "gateway" (Vercel AI Gateway, model ids like "zai/glm-4.6";
#                    on Vercel it authenticates with the deployment's OIDC
#                    token, so no static AI_API_KEY is required) |
#                    "custom"
#   AI_API_BASE_URL  optional override of the provider base URL
#                    (glm default: https://api.z.ai/api/paas/v4)
#   AI_API_KEY       REQUIRED unless the provider fallback covers it (see
#                    AI_PROVIDER above)
#   AI_MODEL         optional model id (glm default: glm-4.6,
#                    gateway default: zai/glm-4.6)
#   AI_TIMEOUT_MS    optional provider timeout, 15000-110000 (default 52000)
# ---------------------------------------------------------------------------
AI_PROVIDER="glm"
AI_API_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_TIMEOUT_MS=""


# ---------------------------------------------------------------------------
# AI Social Media Manager — Phase 2 (SERVER-SIDE ONLY, set in Vercel)
#   META_APP_ID              Meta App "Branify AI Marketing" — public App ID
#   META_APP_SECRET          Meta App secret — NEVER on the client, never in git
#   META_GRAPH_API_VERSION   e.g. "v22.0" (configurable, no hardcoded obsolete)
#   META_REDIRECT_URI        must exactly match the Meta App dashboard setting:
#                            https://branify.store/api/meta/oauth/callback
#   META_TOKEN_ENCRYPTION_KEY  64-char hex (32 bytes) — AES-256-GCM key for
#                            encrypting stored Page/Instagram tokens
#   SUPABASE_SERVICE_ROLE_KEY  server-only; OAuth callback + publisher write
#                            connections with it (RLS bypass server-side only)
#   CRON_SECRET              Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
# ---------------------------------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v22.0"
META_REDIRECT_URI="https://branify.store/api/meta/oauth/callback"
META_TOKEN_ENCRYPTION_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
CRON_SECRET=""
